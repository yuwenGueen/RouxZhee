{
  "$schema": "./theme.schema.json",
  "apiVersion": "rouxzhee.io/theme/v1",
  "id": "rouxzhee-theme-astro",
  "name": "RouxZhee Astro",
  "displayName": "RouxZhee",
  "version": "0.0.4",
  "description": "简洁优雅的个人博客主题，专注于阅读体验",
  "framework": "astro",
  "author": [
    "余温",
    "白木"
  ],
  "license": "commercial",
  "configSchema": "theme.schema.json",
  "contentMode": "markdown",
  "renderModes": [
    "ssg"
  ],
  "build": {
    "packageManager": "npm",
    "install": "npm ci",
    "dev": "npm run dev",
    "build": "npm run build",
    "outputDir": "dist"
  },
  "data": {
    "inputDir": ".site-data",
    "contentDir": "doc"
  },
  "integration": {
    "siteOverviewComponent": "src/components/SiteOverviewPage.vue",
    "siteOverviewPage": "src/pages/site.astro",
    "siteConfig": "src/config/site.config.ts",
    "siteCustomConfig": "src/config/.config/site.config.ts"
  },
  "compatibility": {
    "rouxzheeCore": ">=0.1.0 <1.0.0",
    "node": "^20.19.0 || >=22.12.0",
    "astro": ">=7.0.0 <8.0.0"
  },
  "marketplace": {
    "category": "blog",
    "tags": [
      "Astro",
      "博客",
      "SSG"
    ],
    "preview": "public/assets/shiroki.avif"
  }
}
